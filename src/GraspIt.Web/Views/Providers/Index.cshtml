@model IEnumerable<GraspIt.Application.DTOs.AiProviderDto>
@{ ViewData["Title"] = "LLM Configuration"; }

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1">⚙️ LLM Provider Configuration</h3>
                    <p class="text-secondary mb-0" style="font-size: 0.9rem;">Configure local LLMs (LM Studio, Ollama) or cloud APIs (OpenAI, DeepSeek, Gemini).</p>
                </div>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4">+ Add Provider</a>
            </div>

            <div class="card fade-in-up">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Name</th>
                                    <th>Type</th>
                                    <th>Endpoint</th>
                                    <th>Model</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-medium">@item.Name</td>
                                        <td><span class="badge bg-secondary">@item.ProviderType</span></td>
                                        <td><code style="font-size: 0.8rem; color: var(--accent-hover);">@item.Endpoint</code></td>
                                        <td style="font-size: 0.9rem;">@item.ModelId</td>
                                        <td>
                                            @if (item.IsDefault) { <span class="badge bg-success">Default</span> }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this provider?')">Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

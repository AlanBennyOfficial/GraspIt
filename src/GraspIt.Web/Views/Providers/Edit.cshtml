@model GraspIt.Application.DTOs.AiProviderDto

@{ ViewData["Title"] = "Edit AI Provider"; }

<div class="row mt-4">
    <div class="col-md-6 offset-md-3">
        <h2>Edit AI Provider</h2>
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="ProviderType" class="control-label"></label>
                <select asp-for="ProviderType" class="form-control">
                    <option value="OpenAICompatible">OpenAI Compatible (Local/vLLM/Ollama/OpenAI)</option>
                    <option value="AzureOpenAI">Azure OpenAI</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Endpoint" class="control-label"></label>
                <input asp-for="Endpoint" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="ModelId" class="control-label">Model ID</label>
                <input asp-for="ModelId" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="ApiKey" class="control-label">API Key</label>
                <input asp-for="ApiKey" class="form-control" />
            </div>
            <div class="form-check mb-3">
                <input asp-for="IsDefault" class="form-check-input" />
                <label asp-for="IsDefault" class="form-check-label">Set as Default fallback provider</label>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Update" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

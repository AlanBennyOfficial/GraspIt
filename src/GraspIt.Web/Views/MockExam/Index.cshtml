@{
    ViewData["Title"] = "AI Exam Generator";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card fade-in-up overflow-hidden">
                <div class="card-header py-4 px-5" style="background: var(--gradient-primary) !important; border: none !important;">
                    <h3 class="mb-1 fw-bold text-white">🎓 AI Question Paper Generator</h3>
                    <p class="mb-0 text-white" style="opacity: 0.85; font-size: 0.9rem;">Upload a reference paper → OCR analysis → RAG context → AI generates a new exam matching the format</p>
                </div>
                <div class="card-body p-5">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger mb-4 fade-in-up">⚠️ @TempData["Error"]</div>
                    }

                    <div class="row g-5">
                        <!-- Left: Form -->
                        <div class="col-lg-7">
                            <form asp-action="GenerateExam" asp-controller="MockExam" method="post" enctype="multipart/form-data" id="exam-form">
                                @Html.AntiForgeryToken()

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">1. Reference Paper (Image/PDF)</label>
                                    <input type="file" name="referenceImage" class="form-control form-control-lg" accept=".pdf,.jpg,.jpeg,.png" required />
                                    <div class="form-text">Upload a sample question paper. We'll extract its structure and formatting.</div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">2. Generation Instructions</label>
                                    <textarea name="instructions" class="form-control" rows="4" placeholder="e.g., Generate a 50-mark Mid-Term paper for Computer Networks Unit 1 & 2. Focus on TCP/IP layer functions and include 5 short-answer and 3 long-answer questions." required></textarea>
                                    <div class="form-text">Tell the AI what subject, units, difficulty level, and question distribution you want.</div>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold" id="generate-btn">
                                    ⚡ Generate Mock Exam
                                </button>
                            </form>

                            <!-- Exam Result Preview -->
                            <div id="exam-result-container" class="mt-5" style="display: none;">
                                <div class="card shadow-lg" style="background: rgba(255,255,255,0.02) !important; border: 1px solid var(--border-color) !important;">
                                    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                                        <h5 class="fw-bold mb-0">✨ AI Generated Result</h5>
                                        <div class="d-flex gap-2" id="export-buttons-container">
                                            <!-- AJAX injected buttons -->
                                        </div>
                                    </div>
                                    <div class="card-body p-4">
                                        <div id="exam-markdown-content" class="message-content" style="color: var(--text-primary);"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right: How it works -->
                        <div class="col-lg-5">
                            <h5 class="fw-bold mb-4" style="color: var(--text-secondary);">Pipeline Architecture</h5>
                            <div class="d-flex flex-column gap-4">
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="d-flex align-items-center justify-content-center flex-shrink-0 rounded-circle fw-bold" style="width:32px; height:32px; background: var(--accent-glow); color: var(--accent-hover); font-size: 0.85rem;">1</div>
                                    <div>
                                        <h6 class="fw-bold mb-1" style="font-size: 0.9rem;">Document Extraction</h6>
                                        <p class="text mb-0" style="font-size: 0.82rem; line-height: 1.5;">Native PDF parsing analyzes the reference paper to extract question structure and formatting styles.</p>
                                    </div>
                                </div>
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="d-flex align-items-center justify-content-center flex-shrink-0 rounded-circle fw-bold" style="width:32px; height:32px; background: var(--accent-glow); color: var(--accent-hover); font-size: 0.85rem;">2</div>
                                    <div>
                                        <h6 class="fw-bold mb-1" style="font-size: 0.9rem;">RAG Retrieval</h6>
                                        <p class="text mb-0" style="font-size: 0.82rem; line-height: 1.5;">pgvector performs cosine similarity search to find relevant textbook content matching your instructions.</p>
                                    </div>
                                </div>
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="d-flex align-items-center justify-content-center flex-shrink-0 rounded-circle fw-bold" style="width:32px; height:32px; background: var(--accent-glow); color: var(--accent-hover); font-size: 0.85rem;">3</div>
                                    <div>
                                        <h6 class="fw-bold mb-1" style="font-size: 0.9rem;">AI Generation</h6>
                                        <p class="text mb-0" style="font-size: 0.82rem; line-height: 1.5;">Your local LLM generates structured questions in a standardized JSON format with units, Bloom's levels, and course outcomes.</p>
                                    </div>
                                </div>
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="d-flex align-items-center justify-content-center flex-shrink-0 rounded-circle fw-bold" style="width:32px; height:32px; background: var(--accent-glow); color: var(--accent-hover); font-size: 0.85rem;">4</div>
                                    <div>
                                        <h6 class="fw-bold mb-1" style="font-size: 0.9rem;">Multi-Format Export</h6>
                                        <p class="text mb-0" style="font-size: 0.82rem; line-height: 1.5;">Export to Word (DOCX) with exact NITTE formatting, PDF, Markdown, or LaTeX — all consistent and pixel-perfect.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Store the structured paper JSON in memory (not in DOM) ──────────────
    let _currentPaperJson = null;
    let _currentMarkdown = null;
    let _isStructured = false;

    /**
     * Download a file by posting JSON via fetch and triggering a blob download.
     * This avoids all HTML form encoding issues with embedded JSON.
     */
    async function downloadExamExport(format, event) {
        if (!_isStructured || !_currentPaperJson) {
            alert('No structured paper data available.');
            return;
        }

        const endpoints = {
            docx: '/Export/DownloadExamDocx',
            pdf:  '/Export/DownloadExamPdf',
            md:   '/Export/DownloadExamMarkdown',
            latex: '/Export/DownloadExamLatex'
        };

        const url = endpoints[format];
        if (!url) return;

        const btn = event.target;
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = '⏳...';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: _currentPaperJson
            });

            if (!response.ok) {
                const errorText = await response.text();
                alert(`Export failed: ${errorText}`);
                return;
            }

            // Trigger file download from the response blob
            const blob = await response.blob();
            const contentDisposition = response.headers.get('Content-Disposition');
            let filename = `QuestionPaper.${format === 'latex' ? 'tex' : format}`;
            if (contentDisposition) {
                const match = contentDisposition.match(/filename[^;=\n]*=(['\"]?)([^'\";\n]*)\1/);
                if (match && match[2]) filename = match[2];
            }

            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(a.href);
        } catch (err) {
            alert('Export error: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.textContent = originalText;
        }
    }

    /**
     * Legacy download for non-structured (markdown-based) exports.
     */
    async function downloadLegacyExport(format, event) {
        if (!_currentMarkdown) return;

        const endpoints = {
            docx: '/Export/DownloadDocx',
            pdf:  '/Export/DownloadPdf',
            md:   '/Export/DownloadMarkdown',
            latex: '/Export/DownloadLatex'
        };

        const url = endpoints[format];
        if (!url) return;

        const btn = event.target;
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = '⏳...';

        try {
            const formBody = new URLSearchParams();
            formBody.append('content', _currentMarkdown);

            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formBody
            });

            if (!response.ok) {
                alert('Export failed');
                return;
            }

            const blob = await response.blob();
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `GraspIt_Export.${format === 'latex' ? 'tex' : format}`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(a.href);
        } catch (err) {
            alert('Export error: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.textContent = originalText;
        }
    }

    // ── Main generation form handler ──────────────────────────────────────────
    document.getElementById('exam-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = document.getElementById('generate-btn');
        const resultContainer = document.getElementById('exam-result-container');
        const markdownContent = document.getElementById('exam-markdown-content');
        const exportContainer = document.getElementById('export-buttons-container');

        const originalBtnText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<span class="typing-indicator"><span></span><span></span><span></span></span> Generating... This may take a minute.`;
        resultContainer.style.display = 'none';

        try {
            const formData = new FormData(this);
            const response = await fetch(this.action, {
                method: 'POST',
                body: formData
            });
            const data = await response.json();

            if (data.success) {
                resultContainer.style.display = 'block';
                markdownContent.innerHTML = marked.parse(data.markdown);
                _currentMarkdown = data.markdown;

                if (data.isStructured && data.paperJson) {
                    // ── High-fidelity mode: store JSON in JS variable ──
                    _currentPaperJson = data.paperJson;
                    _isStructured = true;

                    exportContainer.innerHTML = `
                        <button onclick="downloadExamExport('docx', event)" class="btn btn-sm btn-outline-primary px-3" title="High-fidelity Word document with NITTE formatting">📄 DOCX</button>
                        <button onclick="downloadExamExport('pdf', event)" class="btn btn-sm btn-outline-danger px-3" title="PDF with consistent formatting">📕 PDF</button>
                        <button onclick="downloadExamExport('md', event)" class="btn btn-sm btn-outline-info px-3" title="Markdown format">📝 MD</button>
                        <button onclick="downloadExamExport('latex', event)" class="btn btn-sm btn-outline-warning px-3" title="LaTeX source">📐 LaTeX</button>
                    `;
                } else {
                    // ── Legacy mode: markdown-based exports ──
                    _isStructured = false;
                    _currentPaperJson = null;

                    exportContainer.innerHTML = `
                        <button onclick="downloadLegacyExport('docx', event)" class="btn btn-sm btn-outline-primary px-3">DOCX</button>
                        <button onclick="downloadLegacyExport('pdf', event)" class="btn btn-sm btn-outline-danger px-3">PDF</button>
                        <button onclick="downloadLegacyExport('md', event)" class="btn btn-sm btn-outline-info px-3">MD</button>
                        <button onclick="downloadLegacyExport('latex', event)" class="btn btn-sm btn-outline-warning px-3">LaTeX</button>
                    `;
                }
                
                // Scroll to result
                resultContainer.scrollIntoView({ behavior: 'smooth' });
            } else {
                alert("Generation failed: " + data.message);
            }
        } catch (err) {
            alert("Error: " + err.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalBtnText;
        }
    });
</script>
}
